<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:backgroundTint="#000000"
    android:outlineAmbientShadowColor="#000000">

    <Button
        android:id="@+id/commentSectionVizu"
        android:layout_width="388dp"
        android:layout_height="213dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#575757"
        android:fallbackLineSpacing="false"
        android:handwritingBoundsOffsetRight="12dp"
        app:cornerRadius="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.478"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/bookCoverVizu"
        android:layout_width="119dp"
        android:layout_height="174dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/commentSectionVizu"
        app:layout_constraintTop_toTopOf="@+id/commentSectionVizu"
        tools:layout_editor_absoluteX="26dp"
        tools:srcCompat="@drawable/bookcover1" />

    <ImageView
        android:id="@+id/profileVizu"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="@+id/commentSectionVizu"
        app:layout_constraintHorizontal_bias="0.434"
        app:layout_constraintStart_toStartOf="@+id/commentSectionVizu"
        app:layout_constraintTop_toTopOf="@+id/commentSectionVizu"
        tools:srcCompat="@drawable/profileIcon" />

    <TextView
        android:id="@+id/usernameVizu"
        android:layout_width="142dp"
        android:layout_height="25dp"
        android:layout_marginTop="24dp"
        android:text="Username Example"
        android:textColor="#FFFFFF"
        android:textColorLink="#EDEDED"
        app:layout_constraintEnd_toEndOf="@+id/commentSectionVizu"
        app:layout_constraintHorizontal_bias="0.837"
        app:layout_constraintStart_toStartOf="@+id/commentSectionVizu"
        app:layout_constraintTop_toTopOf="@+id/commentSectionVizu" />

    <TextView
        android:id="@+id/ReviewSectionVizu"
        android:layout_width="215dp"
        android:layout_height="112dp"
        android:text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat"
        android:textColor="#D3D3D3"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/commentSectionVizu"
        app:layout_constraintEnd_toEndOf="@+id/commentSectionVizu"
        app:layout_constraintHorizontal_bias="0.861"
        app:layout_constraintStart_toStartOf="@+id/commentSectionVizu"
        app:layout_constraintTop_toTopOf="@+id/commentSectionVizu"
        app:layout_constraintVertical_bias="0.801" />

    <ImageView
        android:id="@+id/starcomment1Vizu"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginTop="55dp"
        android:tint="#FAA72C"
        app:layout_constraintEnd_toEndOf="@+id/commentSectionVizu"
        app:layout_constraintHorizontal_bias="0.556"
        app:layout_constraintStart_toStartOf="@+id/commentSectionVizu"
        app:layout_constraintTop_toTopOf="@+id/commentSectionVizu"
        tools:srcCompat="@drawable/estrela" />

    <ImageView
        android:id="@+id/starcomment2Vizu"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="4dp"
        android:tint="#FAA72C"
        app:layout_constraintBottom_toBottomOf="@+id/starcomment1Vizu"
        app:layout_constraintStart_toEndOf="@+id/starcomment1Vizu"
        app:layout_constraintTop_toTopOf="@+id/starcomment1Vizu"
        app:layout_constraintVertical_bias="0.0"
        tools:srcCompat="@drawable/estrela" />

    <ImageView
        android:id="@+id/starcomment3Vizu"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="4dp"
        android:tint="#FAA72C"
        app:layout_constraintBottom_toBottomOf="@+id/starcomment2Vizu"
        app:layout_constraintStart_toEndOf="@+id/starcomment2Vizu"
        app:layout_constraintTop_toTopOf="@+id/starcomment2Vizu"
        app:layout_constraintVertical_bias="0.0"
        tools:srcCompat="@drawable/estrela" />

    <ImageView
        android:id="@+id/starcomment4Vizu"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="4dp"
        android:tint="#FAA72C"
        app:layout_constraintBottom_toBottomOf="@+id/starcomment3Vizu"
        app:layout_constraintStart_toEndOf="@+id/starcomment3Vizu"
        app:layout_constraintTop_toTopOf="@+id/starcomment3Vizu"
        tools:srcCompat="@drawable/estrela" />

    <ImageView
        android:id="@+id/starcomment5Vizu"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="4dp"
        android:tint="#FAA72C"
        app:layout_constraintBottom_toBottomOf="@+id/starcomment4Vizu"
        app:layout_constraintStart_toEndOf="@+id/starcomment4Vizu"
        app:layout_constraintTop_toTopOf="@+id/starcomment4Vizu"
        app:layout_constraintVertical_bias="0.0"
        tools:srcCompat="@drawable/estrela" />

</androidx.constraintlayout.widget.ConstraintLayout>