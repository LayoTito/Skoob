<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1919"
    tools:context=".activity_signup">

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="101dp"
        android:layout_height="103dp"
        tools:layout_editor_absoluteX="78dp"
        tools:layout_editor_absoluteY="44dp"
        tools:srcCompat="@tools:sample/avatars" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="116dp"
        android:layout_height="47dp"
        android:fontFamily="serif"
        android:text="SKOOB"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        tools:layout_editor_absoluteX="214dp"
        tools:layout_editor_absoluteY="72dp" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="229dp"
        android:layout_height="60dp"
        android:text="Nome de usuário"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        tools:layout_editor_absoluteX="88dp"
        tools:layout_editor_absoluteY="268dp" />

    <Button
        android:id="@+id/button3"
        android:layout_width="301dp"
        android:layout_height="81dp"
        android:text="CRIAR CONTA"
        android:textAlignment="center"
        android:textColorLink="#5A2B2B"
        app:cornerRadius="10dp"
        tools:layout_editor_absoluteX="55dp"
        tools:layout_editor_absoluteY="548dp" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="381dp"
        android:layout_height="30dp"
        android:text="Já possuí uma conta? Faça seu LOGIN."
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="685dp" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="227dp"
        android:layout_height="54dp"
        android:text="Email"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        tools:layout_editor_absoluteX="90dp"
        tools:layout_editor_absoluteY="190dp" />

    <TextView
        android:id="@+id/textView8"
        android:layout_width="231dp"
        android:layout_height="48dp"
        android:text="Senha"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        tools:layout_editor_absoluteX="88dp"
        tools:layout_editor_absoluteY="351dp" />

    <CheckBox
        android:id="@+id/checkBox"
        android:layout_width="356dp"
        android:layout_height="67dp"
        android:backgroundTint="#FFFFFF"
        android:text="Ao criar uma conta, você concorda com nossos termos e nossa política de privacidade."
        android:textColor="#FFFFFF"
        tools:layout_editor_absoluteX="27dp"
        tools:layout_editor_absoluteY="436dp" />

</androidx.constraintlayout.widget.ConstraintLayout>