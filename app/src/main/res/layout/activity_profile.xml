            app:layout_constraintVertical_bias="0.0"
            tools:srcCompat="@drawable/it_cover"
            android:importantForAccessibility="no" />

        <ImageButton
            android:id="@+id/profileButtonFavoriteBook3"
            android:layout_width="103dp"
            android:layout_height="159dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="20dp"
            android:background="#00FFFFFF"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="@+id/profileButtonFavoriteBook2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/profileButtonFavoriteBook2"
            app:layout_constraintTop_toTopOf="@+id/profileButtonFavoriteBook2"
            app:layout_constraintVertical_bias="0.0"
            tools:srcCompat="@drawable/alienista_cover"
