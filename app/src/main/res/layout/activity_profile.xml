<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#00FFFFFF"
    android:fillViewport="true"
    tools:layout_editor_absoluteX="1dp"
    tools:layout_editor_absoluteY="245dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000"
        tools:context=".profileActivity">

        <ImageView
            android:id="@+id/profileImageBackground"
            android:layout_width="411dp"
            android:layout_height="167dp"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:srcCompat="@drawable/profileWalpaper" />

        <ImageView
            android:id="@+id/profileImageLine"
            android:layout_width="411dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="136dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/profileline" />

        <ImageView
            android:id="@+id/profileImageUserIcon"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginTop="120dp"
            android:background="@drawable/round_outline"
            android:clipToOutline="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.498"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:srcCompat="@drawable/profileIcon" />

        <TextView
            android:id="@+id/profileTextUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sarala"
            android:text="User Name"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="@+id/profileImageUserIcon"
            app:layout_constraintHorizontal_bias="0.335"
            app:layout_constraintStart_toStartOf="@+id/profileImageUserIcon"
            app:layout_constraintTop_toBottomOf="@+id/profileImageUserIcon" />

        <TextView
            android:id="@+id/profileTextUserBio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sarala"
            android:text="Phrase"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="@+id/profileTextUsername"
            app:layout_constraintStart_toStartOf="@+id/profileTextUsername"
            app:layout_constraintTop_toBottomOf="@+id/profileTextUsername" />

        <TextView
            android:id="@+id/profileTextUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sarala"
            android:text="User Name"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="@+id/profileImageUserIcon"
            app:layout_constraintHorizontal_bias="0.335"
            app:layout_constraintStart_toStartOf="@+id/profileImageUserIcon"
            app:layout_constraintTop_toBottomOf="@+id/profileImageUserIcon" />

        <TextView
            android:id="@+id/profileTextFavorites"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="296dp"
            android:fontFamily="@font/sarala"
            android:text="FAVORITOS"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.481"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/profileButtonFavoriteBook1"
            android:layout_width="103dp"
            android:layout_height="159dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="15dp"
            android:background="#00352222"
            android:scaleType="centerInside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/profileTextFavorites"
            tools:srcCompat="@drawable/harryCover" />

        <ImageButton
            android:id="@+id/profileButtonFavoriteBook2"
            android:layout_width="103dp"
            android:layout_height="159dp"
            android:layout_marginStart="28dp"
            android:background="#00FFFFFF"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="@+id/profileButtonFavoriteBook1"
            app:layout_constraintStart_toEndOf="@+id/profileButtonFavoriteBook1"
            app:layout_constraintTop_toTopOf="@+id/profileButtonFavoriteBook1"
            app:layout_constraintVertical_bias="0.0"
            tools:srcCompat="@drawable/itCover" />

        <ImageButton
            android:id="@+id/profileButtonFavoriteBook3"
            android:layout_width="103dp"
            android:layout_height="159dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="20dp"
            android:background="#00FFFFFF"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="@+id/profileButtonFavoriteBook2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/profileButtonFavoriteBook2"
            app:layout_constraintTop_toTopOf="@+id/profileButtonFavoriteBook2"
            app:layout_constraintVertical_bias="0.0"
            tools:srcCompat="@drawable/alienistaCover" />

        <TextView
            android:id="@+id/profileTextLastReviews"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="544dp"
            android:fontFamily="@font/sarala"
            android:text="ÚLTIMAS REVIEWS"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.459"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/profileImageSquare"
            android:layout_width="388dp"
            android:layout_height="213dp"
            android:layout_marginTop="580dp"
            android:backgroundTint="#575757"
            android:fallbackLineSpacing="false"
            android:handwritingBoundsOffsetRight="12dp"
            app:cornerRadius="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.478"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/bookImageIcon"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="@+id/profileImageSquare"
            app:layout_constraintHorizontal_bias="0.434"
            app:layout_constraintStart_toStartOf="@+id/profileImageSquare"
            app:layout_constraintTop_toTopOf="@+id/profileImageSquare"
            tools:srcCompat="@drawable/profileIcon" />

        <ImageView
            android:id="@+id/bookImageStar_1"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="55dp"
            android:tint="#FAA72C"
            app:layout_constraintEnd_toEndOf="@+id/profileImageSquare"
            app:layout_constraintHorizontal_bias="0.556"
            app:layout_constraintStart_toStartOf="@+id/profileImageSquare"
            app:layout_constraintTop_toTopOf="@+id/profileImageSquare"
            tools:srcCompat="@drawable/estrela" />

        <ImageView
            android:id="@+id/bookImageStar_2"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="4dp"
            android:tint="#FAA72C"
            app:layout_constraintBottom_toBottomOf="@+id/bookImageStar_1"
            app:layout_constraintStart_toEndOf="@+id/bookImageStar_1"
            app:layout_constraintTop_toTopOf="@+id/bookImageStar_1"
            app:layout_constraintVertical_bias="0.0"
            tools:srcCompat="@drawable/estrela" />

        <ImageView
            android:id="@+id/bookImageStar_3"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="4dp"
            android:tint="#FAA72C"
            app:layout_constraintBottom_toBottomOf="@+id/bookImageStar_2"
            app:layout_constraintStart_toEndOf="@+id/bookImageStar_2"
            app:layout_constraintTop_toTopOf="@+id/bookImageStar_2"
            app:layout_constraintVertical_bias="0.0"
            tools:srcCompat="@drawable/estrela" />

        <ImageView
            android:id="@+id/bookImageStar_4"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="4dp"
            android:tint="#FAA72C"
            app:layout_constraintBottom_toBottomOf="@+id/bookImageStar_3"
            app:layout_constraintStart_toEndOf="@+id/bookImageStar_3"
            app:layout_constraintTop_toTopOf="@+id/bookImageStar_3"
            tools:srcCompat="@drawable/estrela" />

        <ImageView
            android:id="@+id/bookImageStar_5"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="4dp"
            android:tint="#FAA72C"
            app:layout_constraintBottom_toBottomOf="@+id/bookImageStar_4"
            app:layout_constraintStart_toEndOf="@+id/bookImageStar_4"
            app:layout_constraintTop_toTopOf="@+id/bookImageStar_4"
            tools:srcCompat="@drawable/estrela" />

        <TextView
            android:id="@+id/bookTextReview"
            android:layout_width="215dp"
            android:layout_height="112dp"
            android:text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat"
            android:textColor="#D3D3D3"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@+id/profileImageSquare"
            app:layout_constraintEnd_toEndOf="@+id/profileImageSquare"
            app:layout_constraintHorizontal_bias="0.861"
            app:layout_constraintStart_toStartOf="@+id/profileImageSquare"
            app:layout_constraintTop_toTopOf="@+id/profileImageSquare"
            app:layout_constraintVertical_bias="0.801" />

        <TextView
            android:id="@+id/bookTextUsernameReview"
            android:layout_width="142dp"
            android:layout_height="25dp"
            android:layout_marginTop="24dp"
            android:text="Username Example"
            android:textColor="#FFFFFF"
            android:textColorLink="#EDEDED"
            app:layout_constraintEnd_toEndOf="@+id/profileImageSquare"
            app:layout_constraintHorizontal_bias="0.837"
            app:layout_constraintStart_toStartOf="@+id/profileImageSquare"
            app:layout_constraintTop_toTopOf="@+id/profileImageSquare" />

        <ImageView
            android:id="@+id/bookImageReviewBook"
            android:layout_width="119dp"
            android:layout_height="174dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="@+id/profileImageSquare"
            app:layout_constraintTop_toTopOf="@+id/profileImageSquare"
            tools:layout_editor_absoluteX="26dp"
            tools:srcCompat="@drawable/bookcover1" />



    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>


