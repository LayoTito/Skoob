<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1919"
    tools:context=".ReviewActivity">

    <ImageButton
        android:id="@+id/imageButton7"
        android:layout_width="56dp"
        android:layout_height="50dp"
        android:background="@drawable/x"
        tools:layout_editor_absoluteX="7dp"
        tools:layout_editor_absoluteY="7dp" />

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="134dp"
        android:layout_height="165dp"
        tools:layout_editor_absoluteX="250dp"
        tools:layout_editor_absoluteY="89dp"
        tools:srcCompat="@tools:sample/avatars" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="357dp"
        android:layout_height="51dp"
        android:fontFamily="serif"
        android:text="Review"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        tools:layout_editor_absoluteX="55dp"
        tools:layout_editor_absoluteY="6dp" />

    <ImageButton
        android:id="@+id/imageButton5"
        android:layout_width="61dp"
        android:layout_height="61dp"
        android:background="@drawable/estrela"
        tools:layout_editor_absoluteX="329dp"
        tools:layout_editor_absoluteY="286dp" />

    <ImageButton
        android:id="@+id/imageButton3"
        android:layout_width="61dp"
        android:layout_height="61dp"
        android:background="@drawable/estrela"
        tools:layout_editor_absoluteX="170dp"
        tools:layout_editor_absoluteY="286dp" />

    <ImageButton
        android:id="@+id/imageButton2"
        android:layout_width="61dp"
        android:layout_height="61dp"
        android:background="@drawable/estrela"
        tools:layout_editor_absoluteX="247dp"
        tools:layout_editor_absoluteY="286dp" />

    <ImageButton
        android:id="@+id/imageButton4"
        android:layout_width="61dp"
        android:layout_height="61dp"
        android:background="@drawable/estrela"
        tools:layout_editor_absoluteX="89dp"
        tools:layout_editor_absoluteY="286dp" />

    <ImageButton
        android:id="@+id/imageButton6"
        android:layout_width="61dp"
        android:layout_height="61dp"
        android:background="@drawable/estrela"
        tools:layout_editor_absoluteX="13dp"
        tools:layout_editor_absoluteY="286dp" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="191dp"
        android:layout_height="92dp"
        android:fontFamily="serif"
        android:text="Nome do Livro"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="25sp"
        tools:layout_editor_absoluteX="19dp"
        tools:layout_editor_absoluteY="155dp" />

    <EditText
        android:id="@+id/editTextText2"
        android:layout_width="378dp"
        android:layout_height="185dp"
        android:ems="10"
        android:fontFamily="serif"
        android:inputType="text"
        android:text="Escreva sua review..."
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        tools:layout_editor_absoluteX="19dp"
        tools:layout_editor_absoluteY="388dp" />

    <ImageButton
        android:id="@+id/imageButton10"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:background="@drawable/Like"
        tools:layout_editor_absoluteX="19dp"
        tools:layout_editor_absoluteY="611dp" />

    <CheckBox
        android:id="@+id/checkBox"
        android:layout_width="283dp"
        android:layout_height="73dp"
        android:fontFamily="serif"
        android:text="Deixar minha review pública."
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        tools:layout_editor_absoluteX="101dp"
        tools:layout_editor_absoluteY="608dp" />

</androidx.constraintlayout.widget.ConstraintLayout>