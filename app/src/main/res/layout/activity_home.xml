<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#00FFFFFF"
    android:backgroundTint="#00FFFFFF"
    android:fillViewport="true"
    tools:layout_editor_absoluteX="1dp"
    tools:layout_editor_absoluteY="131dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000"
        tools:context=".HomeActivity">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar2"
            android:layout_width="413dp"
            android:layout_height="71dp"
            android:background="?attr/colorPrimary"
            android:backgroundTint="#2B2B2B"
            android:minHeight="?attr/actionBarSize"
            android:theme="?attr/actionBarTheme"
            tools:layout_editor_absoluteX="-1dp"
            tools:layout_editor_absoluteY="-1dp" />

        <ImageView
            android:id="@+id/homeImageLongIcon"
            android:layout_width="180dp"
            android:layout_height="70dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.002"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:srcCompat="@drawable/skoob_icon" />

        <ImageButton
            android:id="@+id/homeButtonTopRated2"
            android:layout_width="100dp"
            android:layout_height="160dp"
            android:layout_marginTop="224dp"
            android:background="@drawable/bookcover2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.498"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/toolbar2"

            />

        <ImageButton
            android:id="@+id/homeButtonTopRated3"
            android:layout_width="100dp"
            android:layout_height="160dp"
            android:layout_marginTop="220dp"
            android:layout_marginEnd="30dp"
            android:background="@drawable/bookcover3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/homeTextTopRated"
            android:layout_width="182dp"
            android:layout_height="30dp"
            android:layout_marginTop="168dp"
            android:autoSizeTextType="none"
            android:fontFamily="@font/sarala"
            android:text="MELHOR AVALIADOS"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.506"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/homeButtonTopRated1"
            android:layout_width="100dp"
            android:layout_height="160dp"
            android:layout_marginStart="30dp"
            android:layout_marginTop="220dp"
            android:background="@drawable/bookcover1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"

            />

        <ImageButton
            android:id="@+id/homeButtonSearch"
            android:layout_width="341dp"
            android:layout_height="50dp"
            android:layout_marginTop="80dp"
            android:background="@drawable/round_outline"
            android:clipToOutline="true"
            android:scaleType="center"
            android:tint="#A8A8A8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/search_bar" />

        <ImageButton
            android:id="@+id/homeButtonSearchConfirmation"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="80dp"
            android:backgroundTint="#00FFFFFF"
            android:scaleType="centerInside"
            android:tint="#595959"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.864"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/magnifying_glass" />

        <ImageView
            android:id="@+id/homeButtonTop10_1"
            android:layout_width="143dp"
            android:layout_height="206dp"
            android:background="@drawable/bookcover13"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:layout_editor_absoluteY="527dp" />

        <ImageButton
            android:id="@+id/homeButtonTop10_2"
            android:layout_width="100dp"
            android:layout_height="160dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bookcover5"
            android:scaleType="center"

            app:layout_constraintStart_toStartOf="parent"
            tools:layout_editor_absoluteY="747dp" />

        <ImageButton
            android:id="@+id/homeButtonTop10_3"
            android:layout_width="100dp"
            android:layout_height="160dp"
            android:background="@drawable/bookcover4"
            tools:layout_editor_absoluteX="150dp"
            tools:layout_editor_absoluteY="747dp"

            />


        <ImageButton
            android:id="@+id/homeButtonTop10_4"
            android:layout_width="100dp"
            android:layout_height="160dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bookcover6"
            app:layout_constraintEnd_toEndOf="parent"

            tools:layout_editor_absoluteY="747dp" />

        <ImageButton
            android:id="@+id/homeButtonTop10_5"
            android:layout_width="100dp"
            android:layout_height="160dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bookcover7"
            app:layout_constraintStart_toStartOf="parent"
            tools:layout_editor_absoluteY="936dp"

            />

        <ImageButton
            android:id="@+id/homeButtonTop10_6"
            android:layout_width="100dp"
            android:layout_height="160dp"
            android:background="@drawable/bookcover8"
            tools:layout_editor_absoluteX="150dp"
            tools:layout_editor_absoluteY="936dp"

            />

        <ImageButton
            android:id="@+id/homeButtonTop10_7"
            android:layout_width="100dp"
            android:layout_height="160dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bookcover9"
            app:layout_constraintEnd_toEndOf="parent"
            tools:layout_editor_absoluteY="936dp" />

        <ImageButton
            android:id="@+id/homeButtonTop10_8"
            android:layout_width="100dp"
            android:layout_height="160dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bookcover10"
            app:layout_constraintStart_toStartOf="parent"
            tools:layout_editor_absoluteY="1128dp" />

        <ImageButton
            android:id="@+id/homeButtonTop10_9"
            android:layout_width="100dp"
            android:layout_height="160dp"
            android:background="@drawable/bookcover11"
            tools:layout_editor_absoluteX="150dp"
            tools:layout_editor_absoluteY="1128dp" />

        <ImageButton
            android:id="@+id/homeButtonTop10_10"
            android:layout_width="100dp"
            android:layout_height="160dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bookcover12"
            app:layout_constraintEnd_toEndOf="parent"
            tools:layout_editor_absoluteY="1128dp" />



        <TextView
            android:id="@+id/homeTextTop10"
            android:layout_width="229dp"
            android:layout_height="46dp"
            android:fontFamily="@font/sarala"
            android:text="TOP 10 DA SEMANA"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.478"
            app:layout_constraintStart_toStartOf="parent"
            tools:layout_editor_absoluteY="461dp" />

        <ImageView
            android:id="@+id/imageView16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/homeButtonTop10_1"
            app:layout_constraintStart_toEndOf="@+id/homeButtonTop10_1"
            app:layout_constraintTop_toTopOf="@+id/homeButtonTop10_1"
            app:srcCompat="@drawable/ornament2" />

        <ImageView
            android:id="@+id/imageView13"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/homeButtonTop10_1"
            app:layout_constraintEnd_toStartOf="@+id/homeButtonTop10_1"
            app:layout_constraintTop_toTopOf="@+id/homeButtonTop10_1"
            app:layout_constraintVertical_bias="0.509"
            app:srcCompat="@drawable/ornament1" />

        <ImageButton
            android:id="@+id/homeImageProfilePic"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="6dp"
            android:background="#00323232"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.982"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/profileIcon" />

        <EditText
            android:id="@+id/editTextText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="text"
            android:text="Name"
            app:layout_constraintBottom_toBottomOf="@+id/homeButtonSearch"
            app:layout_constraintEnd_toStartOf="@+id/homeButtonSearchConfirmation"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="@+id/homeButtonSearch"
            app:layout_constraintTop_toTopOf="@+id/homeButtonSearch"
            app:layout_constraintVertical_bias="1.0" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

