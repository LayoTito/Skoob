<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:layout_editor_absoluteX="187dp"
    tools:layout_editor_absoluteY="350dp"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1B1919"
        tools:context=".BookActivity"
        tools:layout_editor_absoluteX="35dp"
        tools:layout_editor_absoluteY="-17dp">

        <Button
            android:id="@+id/profileImageSquare"
            android:layout_width="388dp"
            android:layout_height="213dp"
            android:layout_marginTop="400dp"
            android:backgroundTint="#575757"
            android:fallbackLineSpacing="false"
            android:handwritingBoundsOffsetRight="12dp"
            app:cornerRadius="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.478"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/bookImageIcon"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="@+id/profileImageSquare"
            app:layout_constraintHorizontal_bias="0.434"
            app:layout_constraintStart_toStartOf="@+id/profileImageSquare"
            app:layout_constraintTop_toTopOf="@+id/profileImageSquare"
            tools:srcCompat="@drawable/profileIcon" />

        <ImageView
            android:id="@+id/bookImageStar_1"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="55dp"
            android:tint="#FAA72C"
            app:layout_constraintEnd_toEndOf="@+id/profileImageSquare"
            app:layout_constraintHorizontal_bias="0.556"
            app:layout_constraintStart_toStartOf="@+id/profileImageSquare"
            app:layout_constraintTop_toTopOf="@+id/profileImageSquare"
            tools:srcCompat="@drawable/estrela" />

        <ImageView
            android:id="@+id/bookImageStar_2"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="4dp"
            android:tint="#FAA72C"
            app:layout_constraintBottom_toBottomOf="@+id/bookImageStar_1"
            app:layout_constraintStart_toEndOf="@+id/bookImageStar_1"
            app:layout_constraintTop_toTopOf="@+id/bookImageStar_1"
            app:layout_constraintVertical_bias="0.0"
            tools:srcCompat="@drawable/estrela" />

        <ImageView
            android:id="@+id/bookImageStar_3"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="4dp"
            android:tint="#FAA72C"
            app:layout_constraintBottom_toBottomOf="@+id/bookImageStar_2"
            app:layout_constraintStart_toEndOf="@+id/bookImageStar_2"
            app:layout_constraintTop_toTopOf="@+id/bookImageStar_2"
            app:layout_constraintVertical_bias="0.0"
            tools:srcCompat="@drawable/estrela" />

        <ImageView
            android:id="@+id/bookImageStar_4"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="4dp"
            android:tint="#FAA72C"
            app:layout_constraintBottom_toBottomOf="@+id/bookImageStar_3"
            app:layout_constraintStart_toEndOf="@+id/bookImageStar_3"
            app:layout_constraintTop_toTopOf="@+id/bookImageStar_3"
            tools:srcCompat="@drawable/estrela" />

        <ImageView
            android:id="@+id/bookImageStar_5"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="4dp"
            android:tint="#FAA72C"
            app:layout_constraintBottom_toBottomOf="@+id/bookImageStar_4"
            app:layout_constraintStart_toEndOf="@+id/bookImageStar_4"
            app:layout_constraintTop_toTopOf="@+id/bookImageStar_4"
            tools:srcCompat="@drawable/estrela" />

        <TextView
            android:id="@+id/bookTextReview"
            android:layout_width="215dp"
            android:layout_height="112dp"
            android:text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat"
            android:textColor="#D3D3D3"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@+id/profileImageSquare"
            app:layout_constraintEnd_toEndOf="@+id/profileImageSquare"
            app:layout_constraintHorizontal_bias="0.861"
            app:layout_constraintStart_toStartOf="@+id/profileImageSquare"
            app:layout_constraintTop_toTopOf="@+id/profileImageSquare"
            app:layout_constraintVertical_bias="0.801" />

        <TextView
            android:id="@+id/bookTextUsernameReview"
            android:layout_width="142dp"
            android:layout_height="25dp"
            android:layout_marginTop="24dp"
            android:text="Username Example"
            android:textColor="#FFFFFF"
            android:textColorLink="#EDEDED"
            app:layout_constraintEnd_toEndOf="@+id/profileImageSquare"
            app:layout_constraintHorizontal_bias="0.837"
            app:layout_constraintStart_toStartOf="@+id/profileImageSquare"
            app:layout_constraintTop_toTopOf="@+id/profileImageSquare" />

        <ImageView
            android:id="@+id/bookImageReviewBook"
            android:layout_width="119dp"
            android:layout_height="174dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="@+id/profileImageSquare"
            app:layout_constraintTop_toTopOf="@+id/profileImageSquare"
            tools:layout_editor_absoluteX="26dp"
            tools:srcCompat="@drawable/bookcover2" />

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="145dp"
            android:layout_height="205dp"
            android:layout_marginTop="112dp"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.105"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/bookcover1" />

        <TextView
            android:id="@+id/textView5"
            android:layout_width="193dp"
            android:layout_height="111dp"
            android:layout_marginTop="10dp"
            android:text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."
            android:textAlignment="gravity"
            android:textColor="#B6B6B6"
            app:layout_constraintEnd_toEndOf="@+id/textView4"
            app:layout_constraintStart_toStartOf="@+id/textView4"
            app:layout_constraintTop_toBottomOf="@+id/textView4" />

        <TextView
            android:id="@+id/bookTextTitle"
            android:layout_width="198dp"
            android:layout_height="46dp"
            android:layout_marginTop="120dp"
            android:fontFamily="@font/sarala"
            android:text="Titulo do livro"
            android:textColor="#DFDFDF"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.854"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView4"
            android:layout_width="192dp"
            android:layout_height="27dp"
            android:fontFamily="@font/sarala"
            android:text="Autor e data de publicação"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="@+id/bookTextTitle"
            app:layout_constraintStart_toStartOf="@+id/bookTextTitle"
            app:layout_constraintTop_toBottomOf="@+id/bookTextTitle" />

        <TextView
            android:id="@+id/textView6"
            android:layout_width="61dp"
            android:layout_height="30dp"
            android:autoSizeTextType="uniform"
            android:text="4,0/5"
            android:textAlignment="center"
            android:textColor="#E3E3E3"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/imageView2"
            app:layout_constraintStart_toEndOf="@+id/imageView2"
            app:layout_constraintTop_toTopOf="@+id/imageView2"
            app:layout_constraintVertical_bias="1.0" />

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="27dp"
            android:layout_height="32dp"
            app:layout_constraintStart_toStartOf="@+id/imageView"
            app:srcCompat="@drawable/estrela"
            tools:layout_editor_absoluteY="324dp" />

        <ImageButton
            android:id="@+id/bookButtonReturn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#00FFFFFF"
            android:scaleType="centerCrop"
            android:tint="#FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.043"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/arrow_left" />

        <ImageButton
            android:id="@+id/imageButton8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#009E9E9E"
            android:scaleType="centerCrop"
            android:tint="#EAEAEA"
            app:layout_constraintEnd_toEndOf="@+id/imageView"
            app:srcCompat="@android:drawable/ic_menu_add"
            tools:layout_editor_absoluteY="317dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
